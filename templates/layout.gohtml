<!doctype html>
<html lang="{{.Lang}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{.Title}}</title>
  <meta name="description" content="{{.Description}}">
  <link rel="canonical" href="{{.Canonical}}">
  {{if and .Page (eq .Page.PageStatus 3)}}<meta name="robots" content="noindex,follow">{{else}}<meta name="robots" content="index,follow,max-image-preview:large">{{end}}
  <meta property="og:type" content="{{if .Page}}article{{else}}website{{end}}">
  <meta property="og:title" content="{{.Title}}">
  <meta property="og:description" content="{{.Description}}">
  <meta property="og:url" content="{{.Canonical}}">
  <meta property="og:site_name" content="{{.SiteName}}">
  {{if .BrandImage}}<meta property="og:image" content="{{.BrandImage}}">{{end}}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#ffffff">
  <link rel="alternate" type="application/atom+xml" title="{{.SiteName}}" href="/feed.xml">
  <link rel="stylesheet" href="/static/bulma.min.css">
  <link rel="stylesheet" href="/static/fontawesome.min.css">
  <link rel="stylesheet" href="/static/main.css?v=bulma-20260829">
  {{if .CodeTheme}}<link rel="stylesheet" href="{{.CodeTheme}}">{{end}}
  <link rel="manifest" href="/manifest.json">
  <link rel="apple-touch-icon" href="/icon512.png">
  <link rel="icon" href="{{.Favicon}}">
  <script defer src="/static/highlight.min.js"></script>
  <script defer src="/static/main.js?v=bulma-20260829"></script>
  {{if .JSONLD}}<script nonce="{{.Nonce}}" type="application/ld+json">{{.JSONLD}}</script>{{end}}
</head>
<body>
<div id="page-container">
  <nav class="navbar nav-shadow" role="navigation" aria-label="main navigation">
    <div class="container">
      <div class="navbar-brand">
        <a class="navbar-item site-brand" href="/">{{.SiteName}}</a>
        <button class="navbar-burger burger" type="button" aria-label="menu" aria-expanded="false" data-target="mainNavbar">
          <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
        </button>
      </div>
      <div id="mainNavbar" class="navbar-menu">
        <div class="navbar-start">
          {{range .PrimaryNav}}<a class="navbar-item" href="{{.Link}}">{{.Text}}</a>{{end}}
          {{range .Nav}}
            {{if .Value}}<div class="navbar-item has-dropdown is-hoverable">
              <span class="navbar-link">{{.Key}}</span>
              <div class="navbar-dropdown">{{range .Value}}<a class="navbar-item" href="{{.Link}}">{{.Text}}</a>{{end}}</div>
            </div>{{end}}
          {{end}}
        </div>
      </div>
    </div>
  </nav>

  <main id="content-wrap">
    <div class="container">
      {{if eq .Kind "index"}}
        <div class="columns is-desktop">
          <section class="column" aria-label="文章列表">
            <div class="page-card-list">
              {{range .Pages}}
                <div class="box index-page-box">
                  <article class="media index-page-media">
                    <div class="media-content"><div class="content">
                      <h2 class="page-card-title"><a href="/page/{{pathEscape .Link}}">{{if eq .PageStatus 2}}「置顶」{{end}}{{if .Title}}{{.Title}}{{else}}无标题{{end}}</a></h2>
                      {{range splitTags .Tag}}<a class="tag is-light" href="/tag/{{pathEscape .}}">{{.}}</a>{{end}}
                      <a class="tag is-light" href="{{archiveURL .CreatedAt}}"><time datetime="{{.CreatedAt}}">{{date .CreatedAt}}</time></a>
                      <span class="tag is-light">{{.View}} views</span>
                      <div class="page-card-text">{{if .Description}}{{.Description}}{{else}}无描述信息{{end}}</div>
                    </div></div>
                  </article>
                </div>
              {{else}}<div class="notification is-light">还没有公开文章。</div>{{end}}
            </div>
            <nav class="pagination is-centered" aria-label="pagination">
              <a class="pagination-previous shadow" href="{{if .PrevURL}}{{.PrevURL}}{{else}}/{{end}}">上一页</a>
              <a class="pagination-next shadow" href="{{if .NextURL}}{{.NextURL}}{{else}}.{{end}}">下一页</a>
            </nav>
          </section>
          <aside class="column is-one-quarter-fullhd index-sidebar">
            <section class="card">
              <p class="card-header-title sidebar-title">{{.SiteName}}</p>
              <div class="card-content sidebar-content"><div class="content">
                {{.Description}}
                {{if .BrandImage}}<img class="brand-image" loading="lazy" src="{{.BrandImage}}" alt="{{.SiteName}}">{{end}}
              </div></div>
            </section>
            {{if .Notice}}<section class="box notice">{{.Notice}}</section>{{end}}
          </aside>
        </div>
      {{else if eq .Kind "custom"}}
        <article class="article-container">{{.Page.Rendered}}</article>
      {{else if eq .Kind "archive"}}
        <section class="archive-container">
          <h1 class="title is-3 archive-title">存档</h1>
          <div class="table-container"><table class="table is-fullwidth is-hoverable is-bordered is-striped"><thead><tr><th>标题</th><th>发布时间</th><th>编辑时间</th></tr></thead><tbody>
            {{range .Pages}}<tr><td><a href="/page/{{pathEscape .Link}}">{{.Title}}</a></td><td><time datetime="{{.CreatedAt}}">{{date .CreatedAt}}</time></td><td><time datetime="{{.UpdatedAt}}">{{date .UpdatedAt}}</time></td></tr>{{end}}
          </tbody></table></div>
        </section>
      {{else if eq .Kind "list"}}
        <section class="archive-container">
          <h1 class="title is-3 archive-title">{{.ListTitle}}</h1>
          <div class="page-card-list">{{range .Pages}}<div class="box index-page-box"><article class="media index-page-media"><div class="media-content"><div class="content"><h2 class="page-card-title"><a href="/page/{{pathEscape .Link}}">{{.Title}}</a></h2><time class="tag is-light" datetime="{{.UpdatedAt}}">{{date .UpdatedAt}}</time><div class="page-card-text">{{.Description}}</div></div></div></article></div>{{else}}<div class="notification is-light">没有匹配的文章。</div>{{end}}</div>
        </section>
      {{else if eq .Kind "message"}}
        <section class="notification is-light message-panel"><h1 class="title is-4">{{.Title}}</h1><p>{{.Message}}</p></section>
      {{else if eq .Kind "links"}}
        <section class="links"><article>{{template "page-info" .}}</article>
          {{range .Links}}<div class="card link-entry"><div class="card-content"><div class="media">{{if .Image}}<div class="media-left"><a href="{{.URL}}" rel="noopener noreferrer"><figure class="image is-48x48"><img loading="lazy" src="{{.Image}}" alt=""></figure></a></div>{{end}}<div class="media-content"><p class="title is-4"><a class="link-entry-title" href="{{.URL}}" rel="noopener noreferrer">{{.Title}}</a></p><p class="subtitle is-6">{{.Description}}</p></div></div></div></div>{{end}}
          {{template "prev-next" .}}
        </section>
      {{else if eq .Kind "raw"}}
        <section class="raw-page">
          {{template "page-info" .}}
          <iframe class="raw-frame" src="/raw/{{pathEscape .Page.Link}}" title="{{.Page.Title}}" sandbox="allow-scripts allow-forms allow-popups allow-modals allow-downloads"></iframe>
          {{template "prev-next" .}}
        </section>
      {{else if eq .Kind "code"}}
        <section class="code-page">
          {{template "page-info" .}}
          <div class="control-panel"><button class="button is-light" type="button" data-focus-code>Focus</button> <button class="button is-light" type="button" data-copy-code>Copy</button></div>
          <pre><code id="code-display">{{.Page.Content}}</code></pre>
          {{if .Copyright}}<div class="copyright">{{.Copyright}}</div>{{end}}
          {{template "prev-next" .}}
        </section>
      {{else if eq .Kind "article"}}
        <div class="article-container article-container-wide">
          <div class="columns is-desktop">
            <div class="column">
              <article id="article">
                {{template "page-info" .}}
                {{if .Page.Password}}
                  <form class="protected-page" data-page-id="{{.Page.ID}}">
                    <label class="label" for="article-password">本篇文章被密码保护，请输入访问密码：</label>
                    <div class="field has-addons"><div class="control"><input class="input" id="article-password" type="password" autocomplete="current-password" placeholder="访问密码" required></div><div class="control"><button class="button" type="submit">提交</button></div></div>
                    <p class="help protected-message" aria-live="polite"></p>
                    <div class="protected-content"></div>
                  </form>
                {{else}}<div class="article-content">{{.Page.Rendered}}</div>{{end}}
                {{if .Copyright}}<div class="copyright">{{.Copyright}}</div>{{end}}
              </article>
            </div>
            <aside class="column is-one-quarter-fullhd">
              <nav class="menu toc" aria-label="文章目录">
                <ul class="menu-list"><li id="toc-container"><p class="toc-title">目录</p><ul id="toc"></ul></li></ul>
              </nav>
            </aside>
          </div>
          {{template "prev-next" .}}
        </div>
      {{end}}
    </div>
  </main>

  <footer id="footer"><div class="content has-text-centered"><p>© {{.Year}} <a href="{{.SiteURL}}">{{.Author}}</a> {{.ExtraFooter}} 由 <a href="https://github.com/songquanpeng/blog">Blog</a> 驱动，主题 <a href="https://github.com/songquanpeng/blog/tree/master/themes/bulma">Bulma</a></p></div></footer>
</div>
</body>
</html>

{{define "page-info"}}
  <h1 class="title is-3 is-4-mobile">{{.Page.Title}}</h1>
  <div class="info">
    <span class="line">标签：{{range .Page.Tags}}<a class="tag is-light" href="/tag/{{pathEscape .}}">{{.}}</a>{{end}}</span>
    <span class="line">发布于：<time class="tag is-light" datetime="{{.Page.CreatedAt}}">{{dateTime .Page.CreatedAt}}</time></span>
    <span class="line">编辑于：<time class="tag is-light" datetime="{{.Page.UpdatedAt}}">{{dateTime .Page.UpdatedAt}}</time></span>
    <span class="line">浏览量：<span class="tag is-light">{{.Page.View}}</span></span>
  </div>
{{end}}

{{define "prev-next"}}
  {{if or .Prev .Next}}<nav class="pagination is-centered" aria-label="相邻文章">
    {{if .Prev}}<a class="pagination-previous shadow" href="/page/{{pathEscape .Prev.Link}}">{{.Prev.Title}}</a>{{end}}
    {{if .Next}}<a class="pagination-next shadow" href="/page/{{pathEscape .Next.Link}}">{{.Next.Title}}</a>{{end}}
  </nav>{{end}}
{{end}}
